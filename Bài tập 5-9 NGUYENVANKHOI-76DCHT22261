#include <iostream>
#include <string>
#include <vector>

using namespace std;

class SinhVien {
private:
    string hoTen;
    int namSinh;
    float diem[4];

public:
    void nhap() {
        cin.ignore();
        cout << "Nhap ho ten: ";
        getline(cin, hoTen);
        cout << "Nhap nam sinh: ";
        cin >> namSinh;
        for (int i = 0; i < 4; i++) {
            cout << "Nhap diem mon " << i + 1 << ": ";
            cin >> diem[i];
        }
    }

    float tinhDTB() const {
        float sum = 0;
        for (int i = 0; i < 4; i++) {
            sum += diem[i];
        }
        return sum / 4.0;
    }

    // Kiem tra dieu kien thi tot nghiep: DTB < 7 va khong co mon nao < 5
    bool duDieuKienThiTotNghiep() const {
        if (tinhDTB() >= 7.0) return false;
        for (int i = 0; i < 4; i++) {
            if (diem[i] < 5.0) return false;
        }
        return true;
    }

    void xuat() const {
        cout << "Ho ten: " << hoTen 
             << " | Nam sinh: " << namSinh 
             << " | DTB: " << tinhDTB() << endl;
    }
};

int main() {
    int n;
    cout << "Nhap so luong sinh vien: ";
    cin >> n;

    vector<SinhVien> ds(n);
    for (int i = 0; i < n; i++) {
        cout << "\n--- Nhap thong tin sinh vien " << i + 1 << " ---" << endl;
        ds[i].nhap();
    }

    cout << "\n=== DANH SÁCH SINH VIÊN ĐỦ ĐIỀU KIỆN THI TỐT NGHIỆP ===" << endl;
    bool coSV = false;
    for (int i = 0; i < n; i++) {
        if (ds[i].duDieuKienThiTotNghiep()) {
            ds[i].xuat();
            coSV = true;
        }
    }
    if (!coSV) {
        cout << "Khong co sinh vien nao du dieu kien thi tot nghiep." << endl;
    }

    return 0;
}

