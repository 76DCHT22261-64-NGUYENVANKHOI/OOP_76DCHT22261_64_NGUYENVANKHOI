    int tuSo;
    int mauSo;

public:
    // Hàm tạo không đối
    PhanSo() {
        tuSo = 0;
        mauSo = 1;
    }

    // Hàm tạo có đối
    PhanSo(int tu, int mau) {
        tuSo = tu;
        mauSo = (mau == 0) ? 1 : mau; // Tránh mẫu số bằng 0
    }

    // Hàm hủy
    ~PhanSo() {
        // Không cần giải phóng bộ nhớ động ở bài này
    }

