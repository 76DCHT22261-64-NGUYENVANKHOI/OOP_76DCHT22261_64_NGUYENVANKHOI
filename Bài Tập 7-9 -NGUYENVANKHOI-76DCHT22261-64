#include <iostream>
#include <cmath>

using namespace std;

// Hàm hỗ trợ tìm ƯCLN để rút gọn phân số
int UCLN(int a, int b) {
    a = abs(a);
    b = abs(b);
    while (b != 0) {
        int r = a % b;
        a = b;
        b = r;
    }
    return a;
}

