    void nhap() {
        cout << "Nhap tu so: ";
        cin >> tuSo;
        do {
            cout << "Nhap mau so (khac 0): ";
            cin >> mauSo;
            if (mauSo == 0) cout << "Mau so phai khac 0! Nhap lai.\n";
        } while (mauSo == 0);
    }

    void rutGon() {
        int uc = UCLN(tuSo, mauSo);
        tuSo /= uc;
        mauSo /= uc;
        if (mauSo < 0) { // Đưa dấu trừ lên tử số
            tuSo = -tuSo;
            mauSo = -mauSo;
        }
    }

    void xuat() const {
        if (mauSo == 1) cout << tuSo;
        else if (mauSo == -1) cout << -tuSo;
        else cout << tuSo << "/" << mauSo;
    }

    // Câu 2: Các phương thức cộng, trừ, nhân, chia 2 phân số
    PhanSo cong(const PhanSo& ps2) const {
        PhanSo kq;
        kq.tuSo = tuSo * ps2.mauSo + ps2.tuSo * mauSo;
        kq.mauSo = mauSo * ps2.mauSo;
        kq.rutGon();
        return kq;
    }

    PhanSo tru(const PhanSo& ps2) const {
        PhanSo kq;
        kq.tuSo = tuSo * ps2.mauSo - ps2.tuSo * mauSo;
        kq.mauSo = mauSo * ps2.mauSo;
        kq.rutGon();
        return kq;
    }

    PhanSo nhan(const PhanSo& ps2) const {
        PhanSo kq;
        kq.tuSo = tuSo * ps2.tuSo;
        kq.mauSo = mauSo * ps2.mauSo;
        kq.rutGon();
        return kq;
    }

    PhanSo chia(const PhanSo& ps2) const {
        PhanSo kq;
        kq.tuSo = tuSo * ps2.mauSo;
        kq.mauSo = mauSo * ps2.tuSo;
        kq.rutGon();
        return kq;
    }
};

