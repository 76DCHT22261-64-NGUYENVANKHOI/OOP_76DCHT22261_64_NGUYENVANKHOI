class PhanSo {
private:
    int tuSo;
    int mauSo;

public:
    // Câu 1: Hàm tạo & hàm hủy
    PhanSo() {
        tuSo = 0;
        mauSo = 1;
    }

    PhanSo(int tu, int mau) {
        tuSo = tu;
        mauSo = (mau == 0) ? 1 : mau;
    }

    ~PhanSo() {}

    // Câu 2: Phương thức rút gọn
    void rutGon() {
        int uc = UCLN(tuSo, mauSo);
        tuSo /= uc;
        mauSo /= uc;
        if (mauSo < 0) {
            tuSo = -tuSo;
            mauSo = -mauSo;
        }
    }

    // Câu 2: Nạp chồng toán tử nhập >> và xuất <<
    friend istream& operator>>(istream& is, PhanSo& ps) {
        cout << "Nhap tu so: ";
        is >> ps.tuSo;
        do {
            cout << "Nhap mau so (khac 0): ";
            is >> ps.mauSo;
            if (ps.mauSo == 0) cout << "Mau so phai khac 0! Nhap lai.\n";
        } while (ps.mauSo == 0);
        return is;
    }

    friend ostream& operator<<(ostream& os, const PhanSo& ps) {
        if (ps.mauSo == 1) os << ps.tuSo;
        else if (ps.mauSo == -1) os << -ps.tuSo;
        else os << ps.tuSo << "/" << ps.mauSo;
        return os;
    }

    // Câu 3: Nạp chồng các toán tử +, -, *, /
    PhanSo operator+(const PhanSo& ps2) const {
        PhanSo kq;
        kq.tuSo = tuSo * ps2.mauSo + ps2.tuSo * mauSo;
        kq.mauSo = mauSo * ps2.mauSo;
        kq.rutGon();
        return kq;
    }

    PhanSo operator-(const PhanSo& ps2) const {
        PhanSo kq;
        kq.tuSo = tuSo * ps2.mauSo - ps2.tuSo * mauSo;
        kq.mauSo = mauSo * ps2.mauSo;
        kq.rutGon();
        return kq;
    }

    PhanSo operator*(const PhanSo& ps2) const {
        PhanSo kq;
        kq.tuSo = tuSo * ps2.tuSo;
        kq.mauSo = mauSo * ps2.mauSo;
        kq.rutGon();
        return kq;
    }

    PhanSo operator/(const PhanSo& ps2) const {
        PhanSo kq;
        kq.tuSo = tuSo * ps2.mauSo;
        kq.mauSo = mauSo * ps2.tuSo;
        kq.rutGon();
        return kq;
    }
